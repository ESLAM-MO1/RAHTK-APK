  "motion": {
    "stateChange": 150,
    "screenTransition": 250,
    "sheetEnter": 200,
    "errorShake": 120,
    "curveStandard": "easeInOut",
    "curveExit": "easeOut"
  },
  "elevation": {
    "level1": { "borderWidth": 1, "shadow": null },
    "level2": { "borderWidth": 0, "shadow": { "dx": 0, "dy": 2, "blur": 8, "color": "#000000", "opacity": 0.08 } }
  },
  "iconSet": "lucide",
  "strokeWidth": 1.75,
  "platform": {
    "invoicing": { "marker": "table" },
    "shipping": { "marker": "truck" },
    "freelance": { "marker": "briefcase" },
    "auctions": { "marker": "gavel" },
    "delivery": { "marker": "bike" }
