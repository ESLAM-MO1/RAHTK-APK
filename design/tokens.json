  "radius": {
    "control": 8,
    "container": 12,
    "sheet": 16,
    "pill": 999
  },
  "size": {
    "iconSmall": 16,
    "iconMedium": 20,
    "iconLarge": 24,
    "touchTarget": 44,
    "buttonHeight": 48,
    "fieldHeight": 52,
    "navbarHeight": 56,
    "maxContentWidth": 720
