  "typography": {
    "fontFamilyArabic": "IBMPlexSansArabic",
    "fontFamilyNumeric": "Manrope",
    "scale": {
      "display": { "size": 32, "height": 40, "weight": 700, "letterSpacing": 0 },
      "headline": { "size": 24, "height": 32, "weight": 700, "letterSpacing": 0 },
      "titleLarge": { "size": 22, "height": 28, "weight": 600, "letterSpacing": 0 },
      "title": { "size": 18, "height": 24, "weight": 600, "letterSpacing": 0 },
      "bodyLarge": { "size": 16, "height": 24, "weight": 400, "letterSpacing": 0 },
      "body": { "size": 14, "height": 22, "weight": 400, "letterSpacing": 0 },
      "label": { "size": 14, "height": 20, "weight": 500, "letterSpacing": 0 },
      "caption": { "size": 12, "height": 18, "weight": 400, "letterSpacing": 0 },
      "micro": { "size": 11, "height": 16, "weight": 500, "letterSpacing": 0.2 }
    }
  },
  "spacing": {
    "x1": 4,
    "x2": 8,
    "x3": 12,
    "x4": 16,
    "x5": 20,
    "x6": 24,
    "x8": 32,
    "x10": 40,
    "x12": 48,
    "x16": 64
