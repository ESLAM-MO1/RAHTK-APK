parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    paths:
        - app
        - database
        - routes
    excludePaths:
        - vendor
        - bootstrap/cache
    ignoreErrors:
        - identifier: missingType.iterableValue
          path: app/Shared/Http/ApiResponse.php
        - identifier: missingType.generics
          path: app/Shared/Modules/ModuleRegistry.php
