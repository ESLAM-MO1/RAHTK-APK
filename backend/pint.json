{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": true,
        "single_quote": true,
        "array_syntax": {
            "syntax": "short"
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        }
    },
    "exclude": [
        "bootstrap/cache"
    ]
}
